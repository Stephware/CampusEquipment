@model CampusEquipment.Core.DTOs.EquipmentDto

@{
    ViewData["Title"] = "Retire Equipment";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4 mb-3">Retire Equipment</h1>
                <p class="text-muted">This keeps the equipment record but changes its status to Retired.</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Asset Code</dt>
                    <dd class="col-sm-8">@Model.AssetCode</dd>

                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>

                    <dt class="col-sm-4">Department</dt>
                    <dd class="col-sm-8">@Model.DepartmentName</dd>
                </dl>

                <form asp-action="Retire" method="post">
                    <input type="hidden" name="id" value="@Model.EquipmentId" />
                    <button type="submit" class="btn btn-danger">Retire Equipment</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
