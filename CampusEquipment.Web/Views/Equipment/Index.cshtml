@model CampusEquipment.Web.Models.EquipmentIndexViewModel

@{
    ViewData["Title"] = "Equipment";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Equipment</h1>
        <p class="text-muted mb-0">Manage campus equipment and assets.</p>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Search</label>
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Asset code, name, or brand" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Category</label>
                <input type="text" name="category" value="@Model.Category" class="form-control" placeholder="Category" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Status</label>
                <input type="text" name="status" value="@Model.Status" class="form-control" placeholder="Status" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Department</label>
                <select name="departmentId" class="form-select">
                    <option value="">All departments</option>
                    @foreach (var department in Model.Departments)
                    {
                        if (Model.DepartmentId == department.DepartmentId)
                        {
                            <option value="@department.DepartmentId" selected>@department.Name</option>
                        }
                        else
                        {
                            <option value="@department.DepartmentId">@department.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Asset Code</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Brand</th>
                        <th>Model</th>
                        <th>Status</th>
                        <th>Department</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Equipment.Any())
                    {
                        @foreach (var item in Model.Equipment)
                        {
                            <tr>
                                <td>@item.AssetCode</td>
                                <td>@item.Name</td>
                                <td>@item.Category</td>
                                <td>@(item.Brand ?? "-")</td>
                                <td>@(item.Model ?? "-")</td>
                                <td>@item.Status</td>
                                <td>@item.DepartmentName</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.EquipmentId" class="btn btn-sm btn-outline-primary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.EquipmentId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <a asp-action="Retire" asp-route-id="@item.EquipmentId" class="btn btn-sm btn-outline-danger">Retire</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No equipment found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
