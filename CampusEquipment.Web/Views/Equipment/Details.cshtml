@model CampusEquipment.Core.DTOs.EquipmentDto

@{
    ViewData["Title"] = "Equipment Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Equipment Details</h1>
        <p class="text-muted mb-0">View the selected equipment record.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.EquipmentId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Asset Code</dt>
            <dd class="col-sm-9">@Model.AssetCode</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category</dd>

            <dt class="col-sm-3">Brand</dt>
            <dd class="col-sm-9">@(Model.Brand ?? "-")</dd>

            <dt class="col-sm-3">Model</dt>
            <dd class="col-sm-9">@(Model.Model ?? "-")</dd>

            <dt class="col-sm-3">Purchase Date</dt>
            <dd class="col-sm-9">@(Model.PurchaseDate?.ToString("yyyy-MM-dd") ?? "-")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@Model.DepartmentName</dd>
        </dl>
    </div>
</div>
